# Copia este archivo a .env y reemplaza los marcadores. NUNCA subas .env al repositorio.

# --- PostgreSQL local (los lee docker-compose.yml) ---
POSTGRES_USER=CAMBIAR_USUARIO
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA
POSTGRES_DB=CAMBIAR_NOMBRE_BD
# POSTGRES_PORT=5432

# --- API ---
DATABASE_URL=postgresql://CAMBIAR_USUARIO:CAMBIAR_CONTRASENA@localhost:5432/CAMBIAR_NOMBRE_BD
JWT_SECRET=CAMBIAR_SECRETO_JWT
# PORT=3001
# Orígenes del frontend permitidos por CORS, separados por comas (sin comodines). Por defecto http://localhost:3000
# CORS_ORIGINS=http://localhost:3000

# --- Base de pruebas (solo local; el nombre debe terminar en _test; la crea pnpm db:test:prepare) ---
TEST_DATABASE_URL=postgresql://CAMBIAR_USUARIO:CAMBIAR_CONTRASENA@localhost:5432/CAMBIAR_NOMBRE_BD_test

# --- DigitalOcean Spaces ---
SPACES_KEY=CAMBIAR_SPACES_KEY
SPACES_SECRET=CAMBIAR_SPACES_SECRET
SPACES_REGION=CAMBIAR_REGION
SPACES_ENDPOINT=CAMBIAR_ENDPOINT
SPACES_BUCKET=CAMBIAR_BUCKET

# --- Almacenamiento de documentos ---
# local (por defecto, guarda en STORAGE_LOCAL_DIR) o spaces (usa las variables SPACES_* de arriba)
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./almacenamiento

# --- Usuario Supervisor inicial (pnpm db:seed:supervisor; la contraseña no se guarda en el repositorio) ---
SEED_SUPERVISOR_CORREO=CAMBIAR_CORREO_SUPERVISOR
SEED_SUPERVISOR_CONTRASENA=CAMBIAR_CONTRASENA_SUPERVISOR
# SEED_SUPERVISOR_NOMBRE=Supervisor
