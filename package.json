{
  "name": "h3ga",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema web H3GA Seguros y Pensiones",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present test",
    "test:reporte": "node scripts/reporte-pruebas.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.mjs",
    "db:seed:supervisor": "node --env-file-if-exists=.env db/seed-supervisor.mjs",
    "etl:importar": "pnpm --filter @h3ga/api build && node --env-file-if-exists=.env apps/api/dist/etl/cli-main.js",
    "pruebas:newman": "node scripts/postman/correr-newman.mjs",
    "db:test:prepare": "node --env-file-if-exists=.env db/preparar-bd-pruebas.mjs",
    "dev:token": "node --env-file-if-exists=.env apps/api/scripts/dev-token.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
